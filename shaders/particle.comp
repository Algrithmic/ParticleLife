/**
 * @file particle.comp
 * @brief Compute shader that advances the particle simulation one step.
 *
 * One invocation per particle (256 per workgroup). Each invocation sums the
 * pairwise forces from every other particle within attractionRadius, using the
 * inter-class attraction matrix and a Lenia-style force curve (forceFn), applies
 * velocity friction, then integrates position with screen-edge wrapping. Reads
 * and writes the shared particle buffer in place; matrix and tunables arrive as
 * uniforms from update_physics().
 */
#version 430 core
layout (local_size_x = 256) in;

/// GPU-side mirror of particle_t: 2D position and velocity.
struct Particle {
    vec2 position;
    vec2 velocity;
};

// particles
layout (std430, binding = 0) buffer ParticleBuffer {
    Particle particles[];
};

// attraction matrix: attraction[a * nClass + b]
layout (std430, binding = 1) buffer AttractionBuffer {
    float matrix[];
};

uniform uint    maxClass;
uniform uint    nClass;
uniform uint    count;
uniform float   deltaTime;
uniform float   frictionRate;
uniform float   attractionRadius;
uniform vec2    worldSize;
uniform bool    infinite;

/**
 * forceFn
 *
 * @brief Force curve as a function of normalized distance and attraction weight.
 *
 * Below beta the force is a fixed short-range repulsion (independent of alpha),
 * ramping from -2 up to 0 at r == beta. Between beta and 1 it is a triangular
 * profile scaled by alpha, so the pair attracts (alpha > 0) or repels (alpha < 0).
 * Beyond r == 1 the force is zero.
 *
 * @param r      Distance normalized by attractionRadius, expected in [0, 1].
 * @param alpha  The inter-class attraction weight in [-1, 1].
 * @return       The scalar force magnitude along the pair's direction vector.
 */
float forceFn(float r, float alpha) {
    float beta = 0.25;
    if (r < beta) 
        return (r / beta - 1.0) * 2.0;
    else if (r < 1.0)
        return alpha * (1.0 - abs(2.0 * r - 1.0 - beta) / (1.0 - beta));
    return 0.0;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= count) return;  // guard: invocations past the last particle do nothing

    uint colorClass_i = i % nClass;
    vec2 position_i = particles[i].position;

    vec2 acceleration = vec2(0.0);

    for (uint j = 0; j < count; j++) {
        if (i == j) continue;

        uint colorClass_j = j % nClass;
        vec2 delta = particles[j].position - position_i;

        // wrap delta across world edges (toroidal mode only)
        if (!infinite) {
            if (delta.x >  worldSize.x / 2.0) delta.x -= worldSize.x;
            if (delta.x < -worldSize.x / 2.0) delta.x += worldSize.x;
            if (delta.y >  worldSize.y / 2.0) delta.y -= worldSize.y;
            if (delta.y < -worldSize.y / 2.0) delta.y += worldSize.y;
        }

        float dist = length(delta);
        if (dist > attractionRadius) continue;  // outside interaction range

        float alpha = matrix[colorClass_i * maxClass + colorClass_j];

        vec2 dir;
        if (dist > 1e-4) {
            dir = delta / dist;
        } 
        else {
            dir  = vec2((i > j) ? 1.0 : -1.0, 0.0);
            dist = 1e-4;
        }

        float f = forceFn(dist / attractionRadius, alpha);
        acceleration += dir * f;
    }

    // frictionRate is a decay rate (1/seconds): 0 = no damping, higher = more damping.
    float friction = pow(0.5, deltaTime * frictionRate);

    particles[i].velocity = particles[i].velocity * friction + acceleration * deltaTime;

    // update position and wrap (toroidal mode only)
    particles[i].position += particles[i].velocity * deltaTime;
    if (!infinite)
        particles[i].position = mod(particles[i].position + worldSize, worldSize);
}